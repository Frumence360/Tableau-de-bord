# Copie ce fichier en .env et remplis tes propres valeurs — ne commite jamais le .env réel

PORT=3000

# Connexion PostgreSQL — adapte selon ton hébergeur (Render, Railway, Supabase DB, RDS, VPS...)
# Format : postgres://utilisateur:motdepasse@hote:5432/nom_base
DATABASE_URL=postgres://frumence:frumence@localhost:5432/frumence_dashboard

# Mets à true si ta base exige SSL (cas fréquent en hébergement managé type Render/Railway)
PGSSL=false

# Secret utilisé pour signer les tokens JWT — change-le pour une longue chaîne aléatoire
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Compte admin créé automatiquement au premier lancement (npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-ce-mot-de-passe

# Durée de validité du token
JWT_EXPIRES_IN=8h

# Origines autorisées pour le CORS (séparées par des virgules)
# Exemples: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
