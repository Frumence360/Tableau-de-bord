  "description": "API Node/Express + PostgreSQL + auth JWT pour le dashboard Frumence Maintenance",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node db/migrate.js",
